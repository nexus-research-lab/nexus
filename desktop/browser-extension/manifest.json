{
  "manifest_version": 3,
  "name": "Nexus Browser",
  "description": "Connects Nexus to Chromium for complete browser automation.",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "debugger",
    "downloads",
    "history",
    "offscreen",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "webNavigation",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nexus Browser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
