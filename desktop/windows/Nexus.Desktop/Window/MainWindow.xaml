<Window
  x:Class="Nexus.Desktop.Window.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:theme="clr-namespace:Nexus.Desktop.Theme"
  xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
  Title="Nexus"
  Background="#F9F9F7"
  Icon="pack://application:,,,/Resources/AppIcon.ico"
  ResizeMode="CanResize"
  SizeChanged="HandleWindowSizeChanged"
  WindowStyle="SingleBorderWindow"
  WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <!-- 原生栏独占窗口命令平面；Web 从下一行开始，不再为 caption controls 预留空域。 -->
    <shell:WindowChrome
      CaptionHeight="34"
      CornerRadius="0"
      GlassFrameThickness="0"
      ResizeBorderThickness="6"
      UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#FF292929" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#12000000" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#22000000" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#66000000" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style
      x:Key="CaptionButtonStyle"
      BasedOn="{StaticResource TitleBarButtonStyle}"
      TargetType="{x:Type Button}">
      <Setter Property="Width" Value="46" />
    </Style>
    <Style
      x:Key="CloseCaptionButtonStyle"
      BasedOn="{StaticResource CaptionButtonStyle}"
      TargetType="{x:Type Button}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFC42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#FFB32318" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- 菜单仍由 WPF 维护键盘与焦点语义；模板只统一顶层入口和浮层的视觉边界。 -->
    <Style x:Key="TitleBarMenuFocusVisualStyle" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Control}">
            <Border
              Margin="4,1"
              BorderBrush="{x:Static theme:NexusNativeTheme.FocusBrush}"
              BorderThickness="2"
              CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="TitleBarMenuItemTemplate" TargetType="{x:Type MenuItem}">
      <Grid x:Name="MenuItemRoot" SnapsToDevicePixels="True">
        <Border
          x:Name="MenuItemSurface"
          MinHeight="32"
          Margin="4,1"
          Padding="10,0"
          Background="Transparent"
          CornerRadius="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
              x:Name="HeaderContent"
              VerticalAlignment="Center"
              ContentSource="Header"
              RecognizesAccessKey="True"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <TextBlock
              x:Name="GestureText"
              Grid.Column="1"
              Margin="28,0,2,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{x:Static theme:NexusNativeTheme.TextMutedBrush}"
              Text="{TemplateBinding InputGestureText}" />
            <TextBlock
              x:Name="SubmenuArrow"
              Grid.Column="2"
              Margin="14,0,2,0"
              VerticalAlignment="Center"
              FontSize="17"
              Foreground="{x:Static theme:NexusNativeTheme.IconDefaultBrush}"
              Text="›"
              Visibility="Collapsed" />
          </Grid>
        </Border>

        <Popup
          x:Name="PART_Popup"
          AllowsTransparency="True"
          Focusable="False"
          HorizontalOffset="-2"
          IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
          Placement="Right"
          PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
          PopupAnimation="Fade"
          StaysOpen="False"
          VerticalOffset="-8">
          <Grid MinWidth="220" Margin="0,4,0,0">
            <Border
              Grid.IsSharedSizeScope="True"
              Padding="4"
              Background="{x:Static theme:NexusNativeTheme.OverlayBrush}"
              BorderBrush="{x:Static theme:NexusNativeTheme.OverlayBorderBrush}"
              BorderThickness="1"
              CornerRadius="16">
              <ScrollViewer
                CanContentScroll="True"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsPresenter
                  x:Name="ItemsPresenter"
                  KeyboardNavigation.DirectionalNavigation="Cycle"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Role" Value="TopLevelHeader">
          <Setter TargetName="MenuItemSurface" Property="MinHeight" Value="30" />
          <Setter TargetName="MenuItemSurface" Property="Margin" Value="1,2" />
          <Setter TargetName="MenuItemSurface" Property="Padding" Value="10,0" />
          <Setter TargetName="MenuItemSurface" Property="CornerRadius" Value="8" />
          <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
          <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0" />
          <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-2" />
        </Trigger>
        <Trigger Property="Role" Value="TopLevelItem">
          <Setter TargetName="MenuItemSurface" Property="MinHeight" Value="30" />
          <Setter TargetName="MenuItemSurface" Property="Margin" Value="1,2" />
          <Setter TargetName="MenuItemSurface" Property="Padding" Value="10,0" />
          <Setter TargetName="MenuItemSurface" Property="CornerRadius" Value="8" />
          <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Role" Value="SubmenuHeader">
          <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
        </Trigger>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.TextStrongBrush}" />
          <Setter
            TargetName="MenuItemSurface"
            Property="Background"
            Value="{x:Static theme:NexusNativeTheme.InteractiveHoverBrush}" />
        </Trigger>
        <Trigger Property="IsSubmenuOpen" Value="True">
          <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.TextStrongBrush}" />
          <Setter
            TargetName="MenuItemSurface"
            Property="Background"
            Value="{x:Static theme:NexusNativeTheme.InteractiveActiveBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="MenuItemSurface" Property="Opacity" Value="0.50" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TitleBarMenuItemStyle" TargetType="{x:Type MenuItem}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.TextDefaultBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource TitleBarMenuFocusVisualStyle}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template" Value="{StaticResource TitleBarMenuItemTemplate}" />
    </Style>
    <Style x:Key="TitleBarMenuSeparatorStyle" TargetType="{x:Type Separator}">
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="16,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border
              Height="1"
              VerticalAlignment="Center"
              Background="{x:Static theme:NexusNativeTheme.DividerSubtleBrush}"
              SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border
      Grid.Row="0"
      Background="#F9F9F7"
      BorderBrush="#18000000"
      BorderThickness="0,0,0,1">
      <Grid x:Name="NativeTitleBar">
        <Grid.Style>
          <Style TargetType="{x:Type Grid}">
            <!-- 常规窗口给四周缩放保留命中边界；最大化后内容贴齐工作区。 -->
            <Setter Property="Margin" Value="6,0,6,0" />
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
                Value="Maximized">
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
          Grid.Column="0"
          AutomationProperties.Name="窗口菜单"
          Click="ShowWindowMenu"
          shell:WindowChrome.IsHitTestVisibleInChrome="True"
          Style="{StaticResource TitleBarButtonStyle}"
          ToolTip="窗口菜单">
          <Image
            Width="18"
            Height="18"
            Source="pack://application:,,,/Resources/AppIcon.ico"
            Stretch="Uniform" />
        </Button>

        <StackPanel
          x:Name="NativeNavigation"
          Grid.Column="1"
          Orientation="Horizontal"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button
            x:Name="BackNavigationButton"
            AutomationProperties.Name="后退"
            Click="NavigateBack"
            IsEnabled="False"
            Style="{StaticResource TitleBarButtonStyle}"
            ToolTip="后退">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              FontSize="13"
              Text="&#xE72B;" />
          </Button>
          <Button
            x:Name="ForwardNavigationButton"
            AutomationProperties.Name="前进"
            Click="NavigateForward"
            IsEnabled="False"
            Style="{StaticResource TitleBarButtonStyle}"
            ToolTip="前进">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              FontSize="13"
              Text="&#xE72A;" />
          </Button>
        </StackPanel>

        <Menu
          x:Name="NativeMenu"
          Grid.Column="2"
          Height="33"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          AutomationProperties.Name="应用菜单"
          Background="Transparent"
          BorderThickness="0"
          IsMainMenu="True"
          ItemContainerStyle="{StaticResource TitleBarMenuItemStyle}"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Menu.Resources>
            <!-- 显式声明的子菜单不会继承 Menu.ItemContainerStyle，资源域负责统一递归层级。 -->
            <Style
              BasedOn="{StaticResource TitleBarMenuItemStyle}"
              TargetType="{x:Type MenuItem}" />
            <Style
              BasedOn="{StaticResource TitleBarMenuSeparatorStyle}"
              TargetType="{x:Type Separator}" />
          </Menu.Resources>
          <MenuItem AutomationProperties.Name="文件" Header="_文件">
            <MenuItem
              AutomationProperties.Name="关闭窗口"
              Click="CloseWindow"
              Header="关闭窗口"
              InputGestureText="Alt+F4" />
            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
            <MenuItem
              AutomationProperties.Name="退出 Nexus"
              Click="ExitApplication"
              Header="退出 Nexus" />
          </MenuItem>
          <MenuItem AutomationProperties.Name="编辑" Header="_编辑">
            <MenuItem
              AutomationProperties.Name="撤销"
              Click="ExecuteWebEditCommand"
              Header="撤销"
              InputGestureText="Ctrl+Z"
              Tag="undo" />
            <MenuItem
              AutomationProperties.Name="重做"
              Click="ExecuteWebEditCommand"
              Header="重做"
              InputGestureText="Ctrl+Y"
              Tag="redo" />
            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
            <MenuItem
              AutomationProperties.Name="剪切"
              Click="ExecuteWebEditCommand"
              Header="剪切"
              InputGestureText="Ctrl+X"
              Tag="cut" />
            <MenuItem
              AutomationProperties.Name="复制"
              Click="ExecuteWebEditCommand"
              Header="复制"
              InputGestureText="Ctrl+C"
              Tag="copy" />
            <MenuItem
              AutomationProperties.Name="粘贴"
              Click="ExecuteWebEditCommand"
              Header="粘贴"
              InputGestureText="Ctrl+V"
              Tag="paste" />
            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
            <MenuItem
              AutomationProperties.Name="全选"
              Click="ExecuteWebEditCommand"
              Header="全选"
              InputGestureText="Ctrl+A"
              Tag="selectAll" />
          </MenuItem>
          <MenuItem AutomationProperties.Name="视图" Header="_视图">
            <MenuItem
              x:Name="BackNavigationMenuItem"
              AutomationProperties.Name="后退"
              Click="NavigateBack"
              Header="后退"
              IsEnabled="False" />
            <MenuItem
              x:Name="ForwardNavigationMenuItem"
              AutomationProperties.Name="前进"
              Click="NavigateForward"
              Header="前进"
              IsEnabled="False" />
            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
            <MenuItem
              AutomationProperties.Name="重新加载"
              Click="ReloadFromTitleBar"
              Header="重新加载"
              InputGestureText="Ctrl+R" />
            <MenuItem
              AutomationProperties.Name="清除缓存并重新加载"
              Click="ClearWebCacheFromTitleBar"
              Header="清除缓存并重新加载" />
          </MenuItem>
          <MenuItem AutomationProperties.Name="帮助" Header="_帮助">
            <MenuItem
              AutomationProperties.Name="检查更新"
              Click="CheckForUpdatesFromTitleBar"
              Header="检查更新" />
            <Separator Style="{StaticResource TitleBarMenuSeparatorStyle}" />
            <MenuItem
              AutomationProperties.Name="关于 Nexus"
              Click="ShowAbout"
              Header="关于 Nexus" />
          </MenuItem>
        </Menu>

        <Grid
          Grid.Column="3"
          HorizontalAlignment="Right"
          Background="Transparent"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
            Grid.Column="0"
            AutomationProperties.Name="最小化"
            Click="MinimizeWindow"
            Style="{StaticResource CaptionButtonStyle}"
            ToolTip="最小化">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              FontSize="10"
              Text="&#xE921;" />
          </Button>
          <Grid
            Grid.Column="1"
            Width="46"
            Height="34">
            <Button Click="MaximizeWindow" ToolTip="最大化">
              <Button.Style>
                <Style
                  BasedOn="{StaticResource CaptionButtonStyle}"
                  TargetType="{x:Type Button}">
                  <Setter Property="AutomationProperties.Name" Value="最大化" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
                      Value="Maximized">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                Text="&#xE922;" />
            </Button>
            <Button Click="RestoreWindow" ToolTip="还原">
              <Button.Style>
                <Style
                  BasedOn="{StaticResource CaptionButtonStyle}"
                  TargetType="{x:Type Button}">
                  <Setter Property="AutomationProperties.Name" Value="还原" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
                      Value="Maximized">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                Text="&#xE923;" />
            </Button>
          </Grid>
          <Button
            Grid.Column="2"
            AutomationProperties.Name="关闭"
            Click="CloseWindow"
            Style="{StaticResource CloseCaptionButtonStyle}"
            ToolTip="关闭">
            <TextBlock
              FontFamily="Segoe MDL2 Assets"
              FontSize="10"
              Text="&#xE8BB;" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid
      x:Name="WebViewContainer"
      Grid.Row="1"
      Background="Transparent">
      <webview:WebView2CompositionControl x:Name="MainWebView" />
    </Grid>
  </Grid>
</Window>
