<Window
  x:Class="Nexus.Desktop.Window.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Nexus.Desktop.Window"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
  Title="Nexus"
  Background="#F0F1EF"
  ResizeMode="CanResize"
  WindowStyle="SingleBorderWindow"
  WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <!-- Web Header 继续占据标题栏平面；窗口按钮由宿主绘制，避免 WebView2 HWND 遮住 DWM 图形。 -->
    <shell:WindowChrome
      CaptionHeight="0"
      CornerRadius="0"
      GlassFrameThickness="0,60,0,0"
      ResizeBorderThickness="6"
      UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="{x:Static system:SystemParameters.WindowCaptionButtonWidth}" />
      <Setter Property="Height" Value="{x:Static system:SystemParameters.WindowCaptionButtonHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#FF2C2117" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16000000" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#26000000" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style
      x:Key="CloseCaptionButtonStyle"
      BasedOn="{StaticResource CaptionButtonStyle}"
      TargetType="{x:Type Button}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFC42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#FFB32318" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="Transparent">
    <Grid x:Name="WebViewContainer" Background="Transparent">
      <local:ChromeWebView2 x:Name="MainWebView" />
    </Grid>
    <Grid
      Panel.ZIndex="1"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Background="#F0F1EF"
      shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <!-- 常规窗口把右侧缩放边界留给 WindowChrome；最大化后按钮贴齐屏幕边缘。 -->
          <Setter Property="Margin" Value="0,0,6,0" />
          <Style.Triggers>
            <DataTrigger
              Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
              Value="Maximized">
              <Setter Property="Margin" Value="0" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        Grid.Column="0"
        AutomationProperties.Name="最小化"
        Click="MinimizeWindow"
        Style="{StaticResource CaptionButtonStyle}"
        ToolTip="最小化">
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          FontSize="10"
          Text="&#xE921;" />
      </Button>
      <Grid
        Grid.Column="1"
        Width="{x:Static system:SystemParameters.WindowCaptionButtonWidth}"
        Height="{x:Static system:SystemParameters.WindowCaptionButtonHeight}">
        <Button Click="MaximizeWindow" ToolTip="最大化">
          <Button.Style>
            <Style
              BasedOn="{StaticResource CaptionButtonStyle}"
              TargetType="{x:Type Button}">
              <Setter Property="AutomationProperties.Name" Value="最大化" />
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
                  Value="Maximized">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock
            FontFamily="Segoe MDL2 Assets"
            FontSize="10"
            Text="&#xE922;" />
        </Button>
        <Button Click="RestoreWindow" ToolTip="还原">
          <Button.Style>
            <Style
              BasedOn="{StaticResource CaptionButtonStyle}"
              TargetType="{x:Type Button}">
              <Setter Property="AutomationProperties.Name" Value="还原" />
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WindowState}"
                  Value="Maximized">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock
            FontFamily="Segoe MDL2 Assets"
            FontSize="10"
            Text="&#xE923;" />
        </Button>
      </Grid>
      <Button
        Grid.Column="2"
        AutomationProperties.Name="关闭"
        Click="CloseWindow"
        Style="{StaticResource CloseCaptionButtonStyle}"
        ToolTip="关闭">
        <TextBlock
          FontFamily="Segoe MDL2 Assets"
          FontSize="10"
          Text="&#xE8BB;" />
      </Button>
    </Grid>
  </Grid>
</Window>
