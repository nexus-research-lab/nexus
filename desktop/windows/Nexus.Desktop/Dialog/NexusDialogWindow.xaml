<!--
  INPUT: 标题、正文、可选详情文档与动作集合。
  OUTPUT: Nexus 原生模态对话框。
  POS: Windows 菜单命令与宿主反馈的统一视觉、键盘和焦点边界。
-->
<Window
  x:Class="Nexus.Desktop.Dialog.NexusDialogWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
  xmlns:theme="clr-namespace:Nexus.Desktop.Theme"
  automation:AutomationProperties.AutomationId="NexusDialogWindow"
  AllowsTransparency="True"
  Background="Transparent"
  FontFamily="Segoe UI"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  SnapsToDevicePixels="True"
  WindowStartupLocation="CenterOwner"
  WindowStyle="None">
  <Window.Resources>
    <Style x:Key="NexusDialogButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border
              x:Name="ButtonSurface"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="8">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter
                  TargetName="ButtonSurface"
                  Property="BorderBrush"
                  Value="{x:Static theme:NexusNativeTheme.PrimaryBrush}" />
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.50" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style
      x:Key="NexusDialogSecondaryButtonStyle"
      BasedOn="{StaticResource NexusDialogButtonStyle}"
      TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{x:Static theme:NexusNativeTheme.InteractiveHoverBrush}" />
      <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.TextDefaultBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{x:Static theme:NexusNativeTheme.InteractiveActiveBrush}" />
          <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.TextStrongBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style
      x:Key="NexusDialogPrimaryButtonStyle"
      BasedOn="{StaticResource NexusDialogButtonStyle}"
      TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{x:Static theme:NexusNativeTheme.BrandActionBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{x:Static theme:NexusNativeTheme.BrandActionHoverBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Opacity" Value="0.88" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NexusDialogCloseButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{x:Static theme:NexusNativeTheme.IconDefaultBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border
              x:Name="CloseSurface"
              Background="{TemplateBinding Background}"
              CornerRadius="8">
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="CloseSurface"
                  Property="Background"
                  Value="{x:Static theme:NexusNativeTheme.InteractiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter
                  TargetName="CloseSurface"
                  Property="Background"
                  Value="{x:Static theme:NexusNativeTheme.InteractiveActiveBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter
                  TargetName="CloseSurface"
                  Property="BorderBrush"
                  Value="{x:Static theme:NexusNativeTheme.PrimaryBrush}" />
                <Setter TargetName="CloseSurface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="34">
    <Border
      Background="{x:Static theme:NexusNativeTheme.OverlayBrush}"
      CornerRadius="16">
      <Border.Effect>
        <DropShadowEffect
          BlurRadius="48"
          Direction="270"
          Opacity="0.16"
          ShadowDepth="16"
          Color="{x:Static theme:NexusNativeTheme.ShadowColor}" />
      </Border.Effect>
    </Border>
    <Border
      Background="{x:Static theme:NexusNativeTheme.OverlayBrush}"
      BorderBrush="{x:Static theme:NexusNativeTheme.OverlayBorderBrush}"
      BorderThickness="1"
      CornerRadius="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
          Grid.Row="0"
          MinHeight="58"
          Margin="24,0,16,0"
          Background="Transparent"
          MouseLeftButtonDown="DragDialog">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Name="TitleText"
            VerticalAlignment="Center"
            FontSize="17"
            FontWeight="SemiBold"
            Foreground="{x:Static theme:NexusNativeTheme.TextStrongBrush}"
            TextTrimming="CharacterEllipsis" />
          <Button
            x:Name="CloseButton"
            Grid.Column="1"
            automation:AutomationProperties.Name="关闭"
            Click="CloseDialog"
            Style="{StaticResource NexusDialogCloseButtonStyle}">
            <TextBlock
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="11"
              Text="&#xE711;" />
          </Button>
        </Grid>

        <Border
          Grid.Row="1"
          Background="{x:Static theme:NexusNativeTheme.DividerSubtleBrush}" />

        <ScrollViewer
          x:Name="BodyScroll"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,20,24,22">
            <TextBlock
              x:Name="MessageText"
              FontSize="13"
              Foreground="{x:Static theme:NexusNativeTheme.TextDefaultBrush}"
              LineHeight="21"
              TextWrapping="Wrap" />
            <Grid
              x:Name="DetailsPanel"
              Margin="0,18,0,0"
              Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock
                x:Name="DetailsTitleText"
                Margin="0,0,0,8"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{x:Static theme:NexusNativeTheme.TextStrongBrush}" />
              <RichTextBox
                x:Name="DetailsView"
                Grid.Row="1"
                MinHeight="120"
                MaxHeight="340"
                Padding="12,8"
                Background="{x:Static theme:NexusNativeTheme.CanvasBrush}"
                BorderBrush="{x:Static theme:NexusNativeTheme.DividerSubtleBrush}"
                BorderThickness="1"
                Foreground="{x:Static theme:NexusNativeTheme.TextDefaultBrush}"
                IsDocumentEnabled="True"
                IsReadOnly="True"
                IsTabStop="False"
                VerticalScrollBarVisibility="Auto" />
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <Border
          Grid.Row="3"
          Background="{x:Static theme:NexusNativeTheme.DividerSubtleBrush}" />

        <Border
          Grid.Row="4"
          Padding="16,14,20,16"
          Background="{x:Static theme:NexusNativeTheme.CanvasBrush}"
          CornerRadius="0,0,16,16">
          <StackPanel
            x:Name="ActionPanel"
            HorizontalAlignment="Right"
            Orientation="Horizontal" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
