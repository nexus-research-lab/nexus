{
  "name": "web",
  "version": "0.1.39",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts eslint.config.mjs",
    "test": "npm run test:contracts && npm run test:components",
    "test:components": "vitest run",
    "test:contracts": "node --test --test-concurrency=4 ./scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:liquid-glass": "node ./scripts/export-liquid-glass-assets.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.5",
